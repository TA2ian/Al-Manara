# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/al_manara

# Webhook (required for production webhook mode)
WEBHOOK_HOST=https://your-domain.example
WEBHOOK_PATH=/webhook

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_TOKEN=generate_a_long_random_webhook_secret
ENCRYPTION_KEY=generate_a_fernet_key

# Rate limiting
RATE_LIMIT_COOLDOWN=5
RATE_LIMIT_HOURLY=100
RATE_LIMIT_DAILY=500

# Order limits
MIN_ORDER=10
MAX_ORDER=5000
DAILY_LIMIT=10000

# Payment
PAYMENT_TIMEOUT=60

# Legacy deployment fallbacks; runtime payment settings should be managed from Admin.
SHAMCASH_USD_ACCOUNT=
SHAMCASH_SYP_ACCOUNT=
SHAMCASH_NAME=

# Legacy fee fallbacks; runtime settings should be managed from Admin.
SERVICE_FEE_PERCENT=0
SERVICE_FEE_FIXED=0

# Backup
BACKUP_RETENTION_DAYS=30

# Maintenance
MAINTENANCE_MODE=false
