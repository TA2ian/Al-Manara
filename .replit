modules = ["postgresql-16", "python-3.11"]
[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BACKUP_RETENTION_DAYS = "30"
DAILY_LIMIT = "10000"
HOST = "0.0.0.0"
MAINTENANCE_MODE = "false"
MAX_ORDER = "1000"
MIN_ORDER = "10"
PAYMENT_TIMEOUT = "60"
PORT = "8000"
RATE_LIMIT_COOLDOWN = "5"
RATE_LIMIT_DAILY = "500"
RATE_LIMIT_HOURLY = "100"
SERVICE_FEE_FIXED = "0"
SERVICE_FEE_PERCENT = "15"
WEBHOOK_PATH = "/webhook"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start bot"

[[workflows.workflow]]
name = "Start bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
